&CONTROL
  calculation = 'bands'
  prefix = 'si'
  outdir = './tmp'
  pseudo_dir = './pseudo'
/
&SYSTEM
  ibrav = 2, celldm(1) = 10.26, nat = 2, ntyp = 1, ecutwfc = 30.0, nbnd = 8
/
&ELECTRONS
  conv_thr = 1.0d-9
/
ATOMIC_SPECIES
 Si 28.086 Si.pz-vbc.UPF
ATOMIC_POSITIONS alat
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS tpiba_b
5
 0.5 0.5 0.5 20 ! L
 0.0 0.0 0.0 20 ! Gamma
 1.0 0.0 0.0 10 ! X
 1.0 0.5 0.0 20 ! W
 0.0 0.0 0.0 1  ! Gamma
